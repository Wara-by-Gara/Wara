{
  "name": "wara",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.0.1",
    "@types/node": "^22.0.0",
    "@wara/tsconfig": "workspace:*",
    "commitlint": "^21.0.1",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "turbo": "^2.9.10",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "@types/react": "~19.1.0",
      "html-webpack-plugin": "5.6.3"
    }
  }
}
