# Expo SDK 54 + pnpm monorepo metro resolver 호환.
# expo-router 등의 transitive dep(@expo/metro-runtime 등)이
# 워크스페이스 root node_modules에 보이도록 hoist.
# api/web에는 영향 없음 (이미 dedupe됨).
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*@expo/*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*@react-native*
public-hoist-pattern[]=*@react-navigation/*
public-hoist-pattern[]=metro
public-hoist-pattern[]=metro-*
public-hoist-pattern[]=react-dom
