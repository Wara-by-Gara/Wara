# K6 부하 테스트 환경변수 예시
# 실제 값으로 채운 뒤 .env.k6 로 저장하고 source .env.k6 후 실행하거나
# k6 run -e KEY=VALUE ... 로 직접 주입한다.

# API 서버 주소 (기본값: http://localhost:3001)
BASE_URL=http://localhost:3001

# 테스트에 사용할 초대장 ULID
INVITATION_ID=01JVXXXXXXXXXXXXXXXXXXXXXXXXX

# 단일 사용자 시나리오용 JWT Access Token
ACCESS_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 다중 사용자 시나리오용 JWT 배열 (JSON 문자열)
# rsvp.js 등 VU별로 다른 사용자가 필요한 시나리오에서 사용
TOKENS=["token_user1","token_user2","token_user3"]
