# 와라 API base URL.
# - EXPO_PUBLIC_ 접두사 환경변수는 클라이언트 번들에 노출됨 → 시크릿은 절대 두지 말 것.
# - dev: 로컬 API 서버 주소
# - prod/staging: EAS Secret로 주입 (이 파일에 prod URL 적지 않기)
EXPO_PUBLIC_API_URL=http://localhost:3001

# 카카오 맵 앱 키 (JavaScript 키)
EXPO_PUBLIC_KAKAO_MAP_APP_KEY=

# 카카오 네이티브 앱 키 — app.config.ts 플러그인이 Info.plist/strings.xml에 주입.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=

# 네이버 로그인 (JS 런타임에 전달 → 번들에 포함됨, 네이버 SDK 구조상 불가피)
EXPO_PUBLIC_NAVER_CLIENT_ID=
EXPO_PUBLIC_NAVER_CLIENT_SECRET=

# 구글 로그인
# GOOGLE_WEB_CLIENT_ID: Google Console 웹 앱 클라이언트 ID (idToken audience, 백엔드 GOOGLE_MOBILE_CLIENT_ID와 일치)
# GOOGLE_IOS_CLIENT_ID: iOS 앱 클라이언트 ID
# GOOGLE_IOS_URL_SCHEME: 역순 iOS 클라이언트 ID (예: com.googleusercontent.apps.XXX)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=
