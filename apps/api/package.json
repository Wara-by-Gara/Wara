{
  "name": "@wara/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "db:generate": "dotenv -e .env.development drizzle-kit generate",
    "db:migrate": "ts-node -r tsconfig-paths/register drizzle/run-migrations.ts",
    "db:migrate:production": "WARA_ENV_FILE=/home/ubuntu/.env.production ts-node -r tsconfig-paths/register drizzle/run-migrations.ts",
    "db:studio": "dotenv -e .env.development drizzle-kit studio",
    "db:seed": "dotenv -e .env.development -- ts-node -r tsconfig-paths/register drizzle/seed/index.ts",
    "db:seed:essential": "dotenv -e .env.development -- ts-node -r tsconfig-paths/register drizzle/seed/seed-essential.ts",
    "db:purge-fixture-seed": "dotenv -e .env.development -- ts-node -r tsconfig-paths/register drizzle/seed/purge-fixture-seed.ts",
    "db:seed:test": "dotenv -e .env.test -- ts-node -r tsconfig-paths/register drizzle/seed/index.ts",
    "db:cleanup-account-seed": "dotenv -e .env.development -- ts-node -r tsconfig-paths/register scripts/cleanup-account-seed-data.ts",
    "db:sync-esther-invitations": "dotenv -e .env.development -- ts-node -r tsconfig-paths/register scripts/sync-esther-invitations.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1047.0",
    "@aws-sdk/s3-request-presigner": "^3.1047.0",
    "@keyv/redis": "^5.1.6",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.1.21",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.21",
    "@sentry/nestjs": "^10.57.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/passport-jwt": "^4.0.1",
    "apple-signin-auth": "^2.0.0",
    "axios": "^1.16.1",
    "bullmq": "^5.78.0",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "expo-server-sdk": "^6.1.0",
    "file-type": "^16.5.4",
    "google-auth-library": "^10.6.2",
    "gray-matter": "^4.0.3",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "keyv": "^5.6.0",
    "nestjs-pino": "^4.6.1",
    "openai": "^6.39.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "ulid": "^3.0.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^7.2.0",
    "@types/web-push": "^3.6.4",
    "@wara/eslint-config": "workspace:*",
    "@wara/tsconfig": "workspace:*",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "jest": "^29.0.0",
    "pino-pretty": "^13.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^expo-server-sdk$": "<rootDir>/../test/mocks/expo-server-sdk.ts"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
