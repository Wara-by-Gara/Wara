DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<db>

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Naver OAuth
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Apple OAuth
APPLE_CLIENT_ID=        # App ID 또는 Service ID
APPLE_TEAM_ID=          # Apple Developer Account의 10자리 팀 ID
APPLE_KEY_ID=           # 발급받은 Key의 10자리 ID
APPLE_PRIVATE_KEY=      # .p8 파일의 내용 (또는 파일 경로)
APPLE_REDIRECT_URI=     # 설정한 Redirect URI

# Admin Bootstrap
#   CSV of ULIDs. INITIAL_ADMIN_USER_IDS=01HXXXX...,01JYYYY...
#   첫 admin은 한 번 가입한 뒤 user.id를 여기 추가하면 다음 로그인부터 admin으로 승격됨 (idempotent).
#   강등은 자동으로 일어나지 않음 — 추가만 반영됨.
#   운영 환경에서는 반드시 Secrets Manager(Vercel/AWS)로 분리.
INITIAL_ADMIN_USER_IDS=
