DATABASE_URL=postgresql://user:password@localhost:5432/db
PORT=
NODE_ENV=

# JWT (담당: 숙희)
JWT_SECRET=

# Admin Bootstrap
#   CSV of ULIDs. INITIAL_ADMIN_USER_IDS=01HXXXX...,01JYYYY...
#   첫 admin은 한 번 가입한 뒤 user.id를 여기 추가하면 다음 로그인부터 admin으로 승격됨 (idempotent).
#   강등은 자동으로 일어나지 않음 — 추가만 반영됨.
#   운영 환경에서는 반드시 Secrets Manager(Vercel/AWS)로 분리.
INITIAL_ADMIN_USER_IDS=
