DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<db>

# Server
PORT=3001
NODE_ENV=development

# Redis (선택) — 미설정 시 redis://localhost:6379. weather 캐시 등에 사용.
REDIS_URL=redis://localhost:6379
# Throttler (선택) — 미설정 시 기본 60req/60s. 부하 테스트 시에만 큰 값으로 우회.
THROTTLER_LIMIT=1000000
THROTTLER_TTL_MS=60000

# JWT
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=1800      # 30분
JWT_REFRESH_EXPIRES_IN=1209600  # 14일

# Cookie
COOKIE_SECRET=                  # 쿠키 서명용 시크릿 (필수)

# CORS
FRONTEND_URL=                   # 프론트엔드 배포 URL (예: https://wara.vercel.app)
ADMIN_FRONTEND_URL=  # 어드민 배포 URL (예: https://admin.wara.kr)

# Kakao
KAKAO_REST_API_KEY=         # 카카오 지도 장소 검색용 REST API 키 (= KAKAO_CLIENT_ID와 동일값)
KAKAO_CLIENT_ID=             # REST API 키
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=          # 웹 서버사이드 OAuth callback URL (예: http://localhost:3000/api/auth/kakao/callback — Next.js /api 프록시 경유)
KAKAO_ADMIN_REDIRECT_URI=    # 어드민 OAuth callback URL (예: http://localhost:3002/api/admin/auth/kakao/callback)

# Naver OAuth
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_CALLBACK_URL=   # 웹 서버사이드 OAuth callback URL (예: http://localhost:3000/api/auth/naver/callback — Next.js /api 프록시 경유)

# Google OAuth
GOOGLE_CLIENT_ID=        # 웹 애플리케이션 클라이언트 ID
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=     # 웹 서버사이드 OAuth callback URL (예: http://localhost:3001/api/auth/google/callback)
GOOGLE_MOBILE_CLIENT_ID= # 모바일 idToken 검증용 — 웹 클라이언트 ID와 동일값

# Apple OAuth
APPLE_CLIENT_ID=         # iOS App Bundle ID (예: com.wara.app)
APPLE_SERVICE_ID=        # 웹 OAuth Service ID (예: com.wara.web) — 웹 로그인용
APPLE_TEAM_ID=           # Apple Developer Account의 10자리 팀 ID
APPLE_KEY_ID=            # 발급받은 Key의 10자리 ID
APPLE_PRIVATE_KEY=       # .p8 파일의 내용 (또는 파일 경로)
APPLE_WEB_REDIRECT_URI=  # Apple 웹 콜백 URL (예: https://api.wara.dev/auth/apple/web-callback)

# AWS
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# OpenAI
OPENAI_API_KEY=   # platform.openai.com에서 발급

# 기상청
KMA_API_KEY=      # data.go.kr에서 발급 (기상청 단기예보 조회서비스, Decoding 키 사용)

# Sentry (선택) — prod에서만 활성화. DSN 미설정 시 init skip → 4xx 노이즈 없이 5xx만 자동 캡처.
SENTRY_DSN=
SENTRY_ENVIRONMENT=   # production / staging 등 prod 내부 환경 태그 (미설정 시 'production')

# Web Push (VAPID) — 백그라운드 푸시 알림용. `npx web-push generate-vapid-keys`로 생성.
# 미설정 시 푸시 발송 skip (in-app 실시간만 동작). 키는 절대 클라이언트에 private 노출 금지.
VAPID_PUBLIC_KEY=     # 클라이언트 구독용 공개키 (GET /push/vapid-public-key로 노출)
VAPID_PRIVATE_KEY=    # 서버 전용 — 절대 커밋/노출 금지
VAPID_SUBJECT=mailto:admin@wara.dev   # 푸시 서비스 연락처 (mailto: 또는 https URL)

# Expo Push (네이티브 모바일) — optional. 미설정이어도 발송 동작, 설정 시 보안 강화 모드
# (Expo dashboard > Access Tokens에서 발급). 서버 전용, 절대 커밋/노출 금지.
EXPO_ACCESS_TOKEN=
