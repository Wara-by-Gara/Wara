DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<db>

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=1800      # 30분
JWT_REFRESH_EXPIRES_IN=1209600  # 14일

# Cookie
COOKIE_SECRET=                  # 쿠키 서명용 시크릿 (필수)

# CORS
FRONTEND_URL=                   # 프론트엔드 배포 URL (예: https://wara.vercel.app)


# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=   # 웹 서버사이드 OAuth callback URL (예: http://localhost:3000/auth/kakao/callback)

# Naver OAuth
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_CALLBACK_URL=   # 웹 서버사이드 OAuth callback URL

# Apple OAuth
APPLE_CLIENT_ID=        # App ID 또는 Service ID
APPLE_TEAM_ID=          # Apple Developer Account의 10자리 팀 ID
APPLE_KEY_ID=           # 발급받은 Key의 10자리 ID
APPLE_PRIVATE_KEY=      # .p8 파일의 내용 (또는 파일 경로)
APPLE_REDIRECT_URI=     # 설정한 Redirect URI
