DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<db>

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Naver OAuth
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Apple OAuth
APPLE_CLIENT_ID=        # App ID 또는 Service ID
APPLE_TEAM_ID=          # Apple Developer Account의 10자리 팀 ID
APPLE_KEY_ID=           # 발급받은 Key의 10자리 ID
APPLE_PRIVATE_KEY=      # .p8 파일의 내용 (또는 파일 경로)
APPLE_REDIRECT_URI=     # 설정한 Redirect URI
