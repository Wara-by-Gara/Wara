sequenceDiagram
    autonumber
    participant Client as Admin User
    participant Interceptor as AuditLogInterceptor
    participant Reflector
    participant Handler as Controller<br/>(@AdminAction)
    participant Repo as AuditLogRepository
    participant Logger

    Client->>Interceptor: HTTP Request<br/>PATCH /admin/users/:id/status
    Interceptor->>Reflector: getAllAndOverride(ADMIN_ACTION_KEY)

    alt @AdminAction 메타데이터 없음
        Reflector-->>Interceptor: undefined
        Interceptor->>Handler: next.handle()
        Handler-->>Client: response (audit log 건너뜀)
    else 메타데이터 있음
        Reflector-->>Interceptor: AdminActionMeta { action, targetType }
        Interceptor->>Handler: next.handle()
        Handler-->>Interceptor: 정상 응답
        Interceptor-->>Client: response (즉시 반환)

        Note over Interceptor,Repo: 비동기 기록 (tap operator,<br/>응답 지연 0)

        Interceptor->>Interceptor: maskSensitive(req.body)<br/>password / token / secret → '***'
        Interceptor->>Repo: insert({adminUserId, action,<br/>targetType, targetId,<br/>requestBody, responseStatus,<br/>ipAddress, userAgent})

        alt INSERT 성공
            Repo-->>Interceptor: void
        else INSERT 실패
            Repo--xInterceptor: Error (DB 장애 등)
            Interceptor->>Logger: logger.error<br/>(응답에는 영향 X)
        end
    end
