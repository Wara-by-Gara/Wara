flowchart TD
    Ctrl["Controller 리턴값<br/>(Service 결과 그대로 통과)"] --> Interceptor["ResponseFormatInterceptor.intercept()<br/>★ main.ts useGlobalInterceptors —<br/>모든 endpoint 자동 적용 ★"]
    Interceptor --> Check{"isPaginatedResult(value)?"}

    Check -- yes --> Pag["{ success: true,<br/>data: value.data,<br/>meta: value.meta }"]
    Check -- no --> Single["{ success: true,<br/>data: value }"]

    Pag --> HTTP[HTTP Response]
    Single --> HTTP

    subgraph TypeGuard ["isPaginatedResult 타입 가드 조건 (전부 충족 시 yes)"]
        direction TB
        C1["1. typeof value === 'object'"]
        C2["2. value !== null"]
        C3["3. Array.isArray(value.data)"]
        C4["4. typeof value.meta === 'object' && meta !== null"]
        C5["5. 'hasNext' in value.meta"]
    end
    Check -.조건.-> TypeGuard

    subgraph FailureNote ["※ 실패 case는 별도 흐름"]
        F["throw HttpException → AllExceptionsFilter/<br/>HttpExceptionFilter가 처리<br/>→ { success: false, error: { code, type, message },<br/>meta: { requestId, timestamp } }"]
    end

    classDef pag fill:#d4edda,stroke:#155724,color:#155724
    classDef single fill:#d1ecf1,stroke:#0c5460,color:#0c5460
    classDef global fill:#cfe2ff,stroke:#084298,color:#084298
    classDef note fill:#f8f9fa,stroke:#6c757d,color:#6c757d,font-size:11px
    class Pag pag
    class Single single
    class Interceptor global
    class C1,C2,C3,C4,C5,F note
