flowchart TD
    subgraph G1 ["1조 영역 (현제 / 민성 / 우진) — OAuth"]
        OAuth["OAuth Callback<br/>(kakao / naver / apple)"]
        FindOrCreate["user = userRepo.findOrCreate(profile)"]
    end

    subgraph Ours ["★ 본 PR 영역 — AdminBootstrapService"]
        Ensure["adminBootstrap.ensureAdminRoleIfEligible(user)"]
        Check{"user.id ∈<br/>INITIAL_ADMIN_USER_IDS env?"}
        AlreadyAdmin{"user.role<br/>=== 'admin'?"}
        Update["userRepo.updateRole(user.id, ADMIN)<br/>← DB UPDATE (1회, idempotent)"]
        Log["logger.log<br/>'Initial admin promoted'"]
        ReturnAsIs["user 그대로 반환"]
        ReturnAdmin["role=admin user 반환"]
    end

    subgraph G2 ["숙희 영역 — JWT 발급"]
        JWT["JwtService.sign(payload)<br/>scope = user.role==='admin' ? ['admin'] : []"]
        Response["클라이언트에 access/refresh 토큰 응답"]
    end

    OAuth --> FindOrCreate
    FindOrCreate --> Ensure
    Ensure --> Check
    Check -- no --> ReturnAsIs
    Check -- yes --> AlreadyAdmin
    AlreadyAdmin -- yes --> ReturnAsIs
    AlreadyAdmin -- no --> Update
    Update --> Log
    Log --> ReturnAdmin
    ReturnAsIs --> JWT
    ReturnAdmin --> JWT
    JWT --> Response

    Note1["env 변경 즉시 반영 X<br/>(다음 로그인 시 매칭)"]
    Note2["강등은 자동으로<br/>일어나지 않음 (추가만 반영)"]
    Note1 -.-> Check
    Note2 -.-> AlreadyAdmin

    classDef external fill:#fff3cd,stroke:#856404,color:#856404
    classDef ours fill:#d1ecf1,stroke:#0c5460,color:#0c5460
    classDef db fill:#d4edda,stroke:#155724,color:#155724
    classDef note fill:#f8f9fa,stroke:#6c757d,color:#6c757d,font-size:11px
    class OAuth,FindOrCreate,JWT,Response external
    class Ensure,Check,AlreadyAdmin,Log,ReturnAsIs,ReturnAdmin ours
    class Update db
    class Note1,Note2 note
